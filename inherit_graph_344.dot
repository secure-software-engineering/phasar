  Node0 -> Node1 [id="edge277_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="psr::CHAResolver",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classpsr_1_1CHAResolver.html",tooltip="A resolver that performs Class Hierarchy Analysis to resolve calls to C++ virtual functions...."];
  Node1 -> Node2 [id="edge278_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
