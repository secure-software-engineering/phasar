  Node1 [id="Node000001",label="psr::Resolver",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="A base class for call-target resolvers. Used to build call graphs."];
  Node1 -> Node2 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="psr::CHAResolver",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classpsr_1_1CHAResolver.html",tooltip="A resolver that performs Class Hierarchy Analysis to resolve calls to C++ virtual functions...."];
  Node2 -> Node3 [id="edge2_Node000002_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="psr::RTAResolver",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classpsr_1_1RTAResolver.html",tooltip="A resolver that performs Rapid Type Analysis to resolve calls to C++ virtual functions...."];
  Node1 -> Node4 [id="edge3_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="psr::NOResolver",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classpsr_1_1NOResolver.html",tooltip="A resolver that doesn't resolve indirect- and virtual calls."];
  Node1 -> Node5 [id="edge4_Node000001_Node000005",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node5 [id="Node000005",label="psr::OTFResolver",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classpsr_1_1OTFResolver.html",tooltip="A resolver that uses alias information to resolve indirect and virtual calls."];
